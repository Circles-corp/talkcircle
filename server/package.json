{
    "name": "circle-server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "tsx watch src/server.ts",
        "lint": "eslint .",
        "format": "prettier --write src",
        "seed": "tsx src/scripts/seed.ts",
        "start": "node --enable-source-maps dist/server.js",
        "test:api": "newman run ../postman/circle.postman_collection.json --env-var baseUrl=http://localhost:4001",
        "test:api:prod": "newman run ../postman/circle.postman_collection.json --env-var baseUrl=https://talkcircle-id64.onrender.com",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.11.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.19.2",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.13.0",
        "newman": "^6.2.3",
        "prettier": "3.9.10",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    }
}
